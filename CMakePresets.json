{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release (RelWithDebInfo)",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PRP_ASAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + TSan",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PRP_TSAN": "ON"
      }
    },
    {
      "name": "static",
      "displayName": "Static (Linux fully static / macOS static deps)",
      "binaryDir": "${sourceDir}/build/static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PRP_STATIC": "ON",
        "PRP_BUILD_TESTS": "OFF",
        "CMAKE_PREFIX_PATH": "$env{PRP_STATIC_PREFIX}"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default", "jobs": 12 },
    { "name": "debug", "configurePreset": "debug", "jobs": 12 },
    { "name": "asan", "configurePreset": "asan", "jobs": 12 },
    { "name": "tsan", "configurePreset": "tsan", "jobs": 12 },
    { "name": "static", "configurePreset": "static", "jobs": 12 }
  ],
  "testPresets": [
    { "name": "default", "configurePreset": "default", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } }
  ]
}
